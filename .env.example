# Google Gemini API Key (required for chat, and for Gemini Live voice chat)
GEMINI_API_KEY=

# Optional fallback keys (comma-separated) - also used for Gemini Live
GEMINI_API_KEYS=

# Optional Tavily search key for web search features
TAVILY_API_KEY=

# Optional CORS Allowed Origin
ALLOWED_ORIGIN=

# Optional Redis / Vercel KV for telemetry & usage stats
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
